<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dct_journal">

    <uses-permission android:name="com.symbol.datawedge.api.ENABLE_DATAWEDGE" />

    <application
        android:name=".ScanDCTApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/dct_journal_terminal_with_wifi_network"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/dct_journal_terminal_with_wifi_network"
        android:supportsRtl="true"
        tools:targetApi="31">

        <activity
            android:name="com.dct_journal.presentation.view.MainActivity"
            android:exported="false" />

        <activity
            android:name="com.dct_journal.presentation.view.DeregistrationActivity"
            android:exported="false" />

    </application>

</manifest>